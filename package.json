{
  "name": "tether-hub",
  "version": "0.6.0",
  "private": true,
  "description": "Tether 自托管管理服务器",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "token": "node dist/token-cli.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test-client": "tsx scripts/test-client.ts",
    "package": "tsx scripts/package.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
